<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="افزودن داروی جدید"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="نام دارو (مثلاً: قرص فشار خون)" />

        <EditText
            android:id="@+id/editDosageNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="توضیح دوز (مثلاً: یک عدد بعد از غذا)" />

        <EditText
            android:id="@+id/editTimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="ساعت‌های مصرف با کاما جدا کنید (مثلاً: 08:00,14:00,20:00)" />

        <EditText
            android:id="@+id/editQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="تعداد موجودی فعلی (مثلاً: 30)"
            android:inputType="number" />

        <EditText
            android:id="@+id/editThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="هشدار موجودی کم از چه تعدادی (مثلاً: 5)"
            android:inputType="number" />

        <EditText
            android:id="@+id/editDosePerIntake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="تعداد مصرف در هر نوبت (پیش‌فرض: 1)"
            android:inputType="number" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary"
            android:text="ذخیره دارو" />

    </LinearLayout>
</ScrollView>
